{
  "name": "la-familia-runner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "De motor van La Familia: pakt taken uit de wachtrij en laat de agents werken.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "once": "tsx src/index.ts --once"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@google/genai": "^2.30.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
